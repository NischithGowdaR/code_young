NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
VITE_API_BASE_URL=http://localhost:4000/api
ADMIN_EMAIL=admin@codeyoung.example
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=CodeYoung Admin

# Email / Brevo API / SMTP Configuration
BREVO_API_KEY=xkeysib-...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="CodeYoung <your-email@gmail.com>"

# Phone SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Groq AI Chat — get your key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_CHAT_ENABLED=true
